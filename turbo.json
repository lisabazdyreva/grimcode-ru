{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env.example", "eslint.config.js"],
  "globalEnv": [
    "NODE_ENV",
    "PROJECT_SLUG",
    "PUBLIC_SITE_URL",
    "DATABASE_URL",
    "EMAIL_PROVIDER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // `web/dist` is the screen of `pg-interface`, built by vite. Without it here a cache hit skips
      // `vite build` and leaves the previous bundle on disk: the source has the change, the served
      // screen does not, and every check is green. Anything a package builds outside `dist` needs a
      // line here for the same reason.
      "outputs": ["dist/**", ".output/**", "web/dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      // `build`, not `^build`: a package's tests read what its own build produced — the screen in
      // `web/dist`, the entry's `dist`. With only the dependencies built, a clean checkout fails.
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
