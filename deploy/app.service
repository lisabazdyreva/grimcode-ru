# The deployed application, as one systemd unit.
#
# What this replaces: the container did four things — it restarted the process, it handed it the
# environment, it collected the logs and it fixed the Node version. The first three are below; the
# fourth is now the machine's business, so whoever installs Node decides which one runs.
#
# Copy to /etc/systemd/system/<name>.service, edit the four paths and the user, then:
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now <name>
#   journalctl -u <name> -f
#
# `EnvironmentFile` is not dotenv: it takes KEY=value lines literally, without `export` and without
# unwrapping quotes. The project's `.env` is written in exactly that form, so it can be used as it
# is — but a value quoted by hand would arrive with its quotes.

[Unit]
Description=Grimcode application
# The database is a local server here. On a managed database, drop this line.
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=grimcode
WorkingDirectory=/srv/grimcode
EnvironmentFile=/srv/grimcode/.env
ExecStart=/usr/bin/node composition/dist/index.js

# The process is stateless: every module opens its own database on the first request that needs one,
# so a restart costs one slow request and nothing else.
Restart=always
RestartSec=2

# Logs go to journald, which is what the container's json-file driver used to do.
StandardOutput=journal
StandardError=journal

# The application writes nothing to disk.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
