# Техническое имя проекта: строчные латинские буквы, цифры и подчёркивания, не длиннее 49 символов
# Длиннее — PostgreSQL молча обрежет имена баз до 63 байт: к слагу добавляется _notifications
PROJECT_SLUG=template

# Диапазон портов для локального запуска
PORT_RANGE_START=63000
PORT_RANGE_END=63020

# Локально - первый localhost порт из диапазона портов для локального запуска
# В продакшне - внешний адрес проекта без порта
PUBLIC_SITE_URL=http://127.0.0.1:63000

# Основная копия: первый порт диапазона приложению, следующий — PostgreSQL
# Менять только вместе с PORT_RANGE_START и PUBLIC_SITE_URL
GATEWAY_PORT=63000
POSTGRES_PORT=63001

# Локально - оставить как есть
# В продакшне - строка подключения к базе данных, отдельной от проекта
DATABASE_URL=postgres://template:template@postgres:5432/postgres

# Пароли ролей модулей: у каждого модуля своя роль и своя база, и чужую он открыть не может
# Локально - оставить как есть; в продакшне - задать разные и хранить как секреты
DB_PASSWORD_ADMIN=template_admin
DB_PASSWORD_AUTH=template_auth
DB_PASSWORD_USERS=template_users
DB_PASSWORD_NOTIFICATIONS=template_notifications
DB_PASSWORD_EMAIL=template_email

# Где искать PostgreSQL, когда приложение запускается на машине, а не в контейнере (pnpm dev):
# имя postgres существует только внутри сети compose, а порт берётся из POSTGRES_PORT.
# В compose эта переменная контейнеру не объявляется, поэтому там ничего не меняется.
LOCAL_POSTGRES_HOST=127.0.0.1

# Сколько времени живёт сессия, в секундах
AUTH_SESSION_TTL_SECONDS=2592000

# Сколько неудачных попыток входа разрешено на один адрес и за какое окно, в секундах
AUTH_LOGIN_ATTEMPT_LIMIT=10
AUTH_LOGIN_ATTEMPT_WINDOW_SECONDS=900

# Как отправляем письма: log (письма сохраняются локально) / unisender (Unisender Go)
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Template

# Ключ Unisender Go, если используется
UNISENDER_GO_API_KEY=
